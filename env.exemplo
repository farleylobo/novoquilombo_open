# Copie este arquivo para .env (com ponto) e preencha. Veja docs/DEPLOY.md. O .env é privado.
NETLIFY_TOKEN=
NETLIFY_SITE_ID=
# Endereço público do mapa (usado na mensagem da semana do painel)
RNQ_SITE_URL=

# Painel admin com login (docs/PAINEL-ADMIN.md). Preencha as 5 primeiras e rode: python3 painel_admin.py configurar
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
RNQ_ADMIN_EMAIL=
RNQ_ADMIN_NOME=
RNQ_PAINEL_URL=https://painel-novoquilombo.netlify.app
# Preenchidas pelo "configurar" (a chave secreta nunca sai deste Mac):
SUPABASE_URL=
SUPABASE_SECRET_KEY=
NETLIFY_PAINEL_SITE_ID=2b3b7b89-b014-432c-8ecb-ec4befb94c8d
# Opcional — e-mail próprio para convidar outras pessoas (ex.: Gmail da rede com senha de app):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Rede Novo Quilombo
